# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# Every variable is optional; the site builds and runs without any of them.

# ── Site URL ────────────────────────────────────────────────────────────
# Production URL used for canonical links, sitemap.xml, robots.txt, and
# Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://nitin-wagmode-portfolio.vercel.app

# ── Contact form email (server-side only — never exposed to the browser) ─
# Option A: Gmail. Use a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords), not your normal password.
EMAIL_USER=
EMAIL_PASS=

# Option B: any SMTP provider (Brevo, Resend SMTP, Zoho, SendGrid, ...).
# Takes precedence over Option A when all three of HOST/USER/PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered (defaults to the email in src/data/profile.js)
CONTACT_TO_EMAIL=
# Sender address; defaults to the SMTP/Gmail user. Must be allowed by your provider.
CONTACT_FROM_EMAIL=

# ── Optional integrations ───────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Blog ────────────────────────────────────────────────────────────────
# Draft posts (draft: true) show in development. Set to "true" to also include
# them in a production build (e.g. a Vercel Preview deployment for review).
# Read at BUILD time — redeploy after changing it.
SHOW_DRAFT_POSTS=false
