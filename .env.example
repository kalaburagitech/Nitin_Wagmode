# Copy to .env.local for local development (git-ignored), and add the same
# keys in Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real values. Every variable is optional for building.

# ── Site URL ────────────────────────────────────────────────────────────
# Production URL used for canonical links, sitemap.xml, robots.txt, Open Graph
# tags, and the confirmation email signature. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://nitin-wagmode.vercel.app

# ── Contact form email (server-side only — never exposed to the browser) ─
# Gmail: smtp.gmail.com, port 465 with SMTP_SECURE=true (implicit TLS), your
# Gmail address as SMTP_USER, and a Google App Password as SMTP_PASS
# (Google Account → Security → 2-Step Verification → App passwords).
# Other providers: e.g. port 587 with SMTP_SECURE=false (STARTTLS required).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Inbox that receives enquiries (defaults to the email in src/data/profile.js).
CONTACT_TO_EMAIL=
# Sender for the enquiry and the visitor's confirmation. Defaults to SMTP_USER.
# With Gmail it must be the account itself or a verified "Send mail as" alias.
CONTACT_FROM_EMAIL=

# ── Contact form rate limiting (recommended in production) ──────────────
# Upstash Redis REST credentials (Upstash console → database → REST API).
# When set, the 5-messages-per-10-minutes limit and duplicate-submission
# protection are shared by every serverless instance. When empty they live in
# per-instance memory, which does not reliably stop abuse on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional integrations ───────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Blog ────────────────────────────────────────────────────────────────
# Draft posts (draft: true) show in development. Set to "true" to also include
# them in a production build (e.g. a Vercel Preview deployment for review).
# Read at BUILD time — redeploy after changing it.
SHOW_DRAFT_POSTS=false
